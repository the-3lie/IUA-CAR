# Chaîne de connexion Neon "pooled" (avec sslmode=require)
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret pour signer les sessions (32 caractères minimum). Générer : openssl rand -base64 48
AUTH_SECRET=remplacez-par-une-longue-valeur-aleatoire-de-32-caracteres-ou-plus

# Compte administrateur initial (créé automatiquement au premier lancement)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangezMoi!2026
